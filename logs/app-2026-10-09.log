function toggleIcons() {
    const expandedIcons = document.getElementById('expandedIcons');
    const mainIcon = document.getElementById('mainIcon');

    if (expandedIcons.style.display === 'none') {
        expandedIcons.style.display = 'flex';
        mainIcon.classList.add('hidden');
    } else {
        expandedIcons.style.display = 'none';
        mainIcon.classList.remove('hidden');
    }
}

function closeIcons() {
    document.getElementById('expandedIcons').style.display = 'none';
    document.getElementById('mainIcon').classList.remove('hidden');
}


</script>

